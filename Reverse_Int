class Solution:
    def reverse(self, x: int) -> int:
        # Step 1: Handle the sign
        sign = -1 if x < 0 else 1
        x = abs(x) # <--- MAKE SURE THIS IS ALIGNED WITH 'sign'
        
        # Step 2: Reverse as a string
        res = int(str(x)[::-1]) * sign
        
        # Step 3: Limits
        if res < -2**31 or res > 2**31 - 1:
            return 0
            
        return res
        return res
